class Solution:
    def beautySum(self, s: str) -> int:
        ans=0
        for i in range(len(s)):
            freq=[0]*26
            for j in range(i,len(s)):
                freq[ord(s[j])-ord('a')]+=1
                max_fre=max(freq)
                min_fre=min(x for x in freq if x>0)
                ans+=max_fre-min_fre
        return ans        
