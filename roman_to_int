class Solution:
    def romanToInt(self, s: str) -> int:
        n=len(s)
        values={
            'I':1,
            'V':5,
            'X':10,
            'L':50,
            'C':100,
            'D':500,
            'M':1000
        }
        ans=0
        for i in range(n):
            if i+1<n and values[s[i]]<values[s[i+1]]:
                ans-=values[s[i]]
            else:
                ans+=values[s[i]]
        return ans            

        #Current < Next → subtract
        #Current >= Next → add
