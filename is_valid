
def isValid(s):
    stack = []

    for ch in s:
        if ch in "({[":
            stack.append(ch)

        else:
            if not stack:
                return False

            top = stack.pop()

            if ch == ')' and top != '(':
                return False
            if ch == '}' and top != '{':
                return False
            if ch == ']' and top != '[':
                return False

    return len(stack) == 0


s = input("Enter brackets: ")

if isValid(s):
    print("Balanced")
else:
    print("Not Balanced")
