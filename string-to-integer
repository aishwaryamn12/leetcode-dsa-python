class Solution:
    def myAtoi(self, s: str) -> int:
        i=0
        n=len(s)
        while i<n and s[i]==' ':
            i+=1
        sign=1
        if i<n and s[i]=='-':
            sign=-1
            i+=1
        elif i<n and s[i]=='+':
            i+=1
        ans=0
        while i<n and s[i].isdigit():
            digit=int(s[i])
            ans=ans*10+digit
            i+=1
        ans=ans*sign
        INT_MIN=-2**31
        INT_MAX=2**31-1
        if ans<INT_MIN:
            return INT_MIN  
        if ans>INT_MAX:
            return INT_MAX
        return ans                 
        
