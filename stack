stack = []

# Push operation
stack.append(10)
stack.append(20)
stack.append(30)
stack.append(40)

print("Stack:", stack)

# Pop operation
stack.pop()
print("After Pop:", stack)

# Peek operation
print("Top Element:", stack[-1])

# Check if stack is empty
if len(stack) == 0:
    print("Stack is Empty")
else:
    print("Stack is Not Empty")

# Stack size
print("Stack Size:", len(stack))
